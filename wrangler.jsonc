{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infinite-ai-slop",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "infiniteaislop.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/status.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infinite-slop-production",
      "database_id": "f3946d2e-4a8a-44af-93f0-910b13d061ef",
      "migrations_dir": "./worker/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VIDEO_MEDIA",
      "id": "188413eca15a4cd4aa755dfdd06ddcca"
    }
  ],
  "vars": {
    "ORANGE_API_BASE": "https://api.orangeapi.chat/v1",
    "ORANGE_MODEL": "wan2.7-t2v",
    "ORANGE_DURATION_SECONDS": "10",
    "ORANGE_RESOLUTION": "720P",
    "GROK_RESOLUTION": "480P",
    "ORANGE_RATIO": "16:9",
    "ORANGE_WATERMARK": "true",
    "TEXT_POLISH_API_BASE": "https://ai-cpa-cf.nullatoms.com/v1",
    "TEXT_POLISH_MODEL": "gpt-5.4-mini",
    "TEXT_POLISH_ENABLED": "true",
    "VIDEO_BUFFER_TARGET": "8",
    "VIDEO_ARCHIVE_LIMIT": "300",
    "PLAYBACK_RECENCY_WINDOW": "24",
    "CHAT_SNAPSHOT_LIMIT": "60",
    "CHAT_PAGE_LIMIT": "100",
    "MAX_PAID_GENERATIONS_PER_DAY": "100",
    "CHANNEL_BOT_ENABLED": "true",
    "CHANNEL_BOT_GROK_ENABLED": "false",
    "CHANNEL_BOT_FREE_MODEL": "agnes-video-v2.0",
    "CHANNEL_BOT_FREE_MODEL_EVERY": "3",
    "CHANNEL_BOT_INTERVAL_MINUTES": "10"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
