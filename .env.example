HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/channel.sqlite

# Enables the protected moderation list and approve/reject endpoints.
ADMIN_TOKEN=replace-with-a-long-random-token

# The local deterministic provider is the safe default. To generate real
# videos, set VIDEO_PROVIDER=fal and FAL_KEY in the server environment only.
VIDEO_PROVIDER=mock
FAL_KEY=

PROMPT_RATE_LIMIT=5
VOTE_RATE_LIMIT=30
LIKE_RATE_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000
