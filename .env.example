HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/channel.sqlite
MEDIA_DIR=data/videos

# Enables the protected moderation list and approve/reject endpoints.
ADMIN_TOKEN=replace-with-a-long-random-token

# The local deterministic provider is the safe default. Real providers never
# seed demo jobs unless SEED_DEMO_QUEUE is explicitly enabled.
VIDEO_PROVIDER=mock
SEED_DEMO_QUEUE=false
FAL_KEY=
FAL_MODEL=minimax/h3-max/text-to-video

# OrangeAPI: explicit server-side environment credentials take precedence. On
# macOS, the canonical gateway can otherwise read Keychain service
# open-inifiniteslop.orangeapi / account orangeapi-production.
ORANGE_API_BASE=https://api.orangeapi.chat/v1
ORANGE_API_KEY=
ORANGE_MODEL=happyhorse-1.0-t2v
ORANGE_DURATION_SECONDS=3
ORANGE_RESOLUTION=720P
ORANGE_RATIO=16:9
ORANGE_WATERMARK=true
ORANGE_POLL_INTERVAL_MS=2000

GENERATION_CONCURRENCY=1
GENERATION_MAX_ATTEMPTS=3
BUFFER_TARGET=4
WORKER_INTERVAL_MS=750
ROTATION_INTERVAL_MS=500
MOCK_GENERATION_DELAY_MS=800
PROVIDER_TIMEOUT_MS=900000

PROMPT_RATE_LIMIT=5
VOTE_RATE_LIMIT=30
LIKE_RATE_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000
