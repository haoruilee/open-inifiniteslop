{
  "name": "open-inifiniteslop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build:client": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:worker": "tsc -p tsconfig.worker.json",
    "build": "pnpm build:client && pnpm build:server && pnpm build:worker",
    "test": "NODE_ENV=test tsx --test server/tests/*.test.ts",
    "start": "node server-dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "check": "pnpm test && pnpm build && pnpm smoke && pnpm check:worker && pnpm check:secrets",
    "preview": "vite preview --host 127.0.0.1",
    "cf:types": "wrangler types worker/worker-configuration.d.ts --include-runtime false",
    "cf:dev": "pnpm build:client && wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.127.1"
  }
}
